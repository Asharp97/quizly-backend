generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions", "relationJoins", "nativeDistinct", "prismaSchemaFolder", "multiSchema"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [hstore(schema: "public"), pg_trgm, uuidOssp(map: "uuid-ossp")]
}

generator nestgraphql {
  provider = "prisma-nestjs-graphql"
  output   = "../../types"
}

enum user_role {
  USER
  ADMIN
}

model User {
  id       String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  email    String    @unique
  /// @HideField()
  password String
  role     user_role @default(USER)
  name     String?

  createdAt      DateTime         @default(now()) @db.Timestamptz
  updatedAt      DateTime         @updatedAt @db.Timestamptz
  deletedAt      DateTime?        @db.Timestamptz
  QuizSubmission QuizSubmission[]
  Quiz           Quiz[]
}

model Quiz {
  id             String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  title          String
  link           String    @unique
  userId         String    @db.Uuid
  description    String?
  timeLimit      Int?
  deadline       DateTime? @db.Timestamptz
  publishedAt    DateTime  @default(now()) @db.Timestamptz
  enableFeedback Boolean   @default(false)
  // shuffleQuestions Boolean   @default(false)
  // enableTimer      Boolean   @default(false)
  // allowRetake      Boolean   @default(false)
  // maxRetakes       Int?      @default(0)
  // passPercentage   Int?      @default(0)

  createdAt      DateTime         @default(now()) @db.Timestamptz
  updatedAt      DateTime         @updatedAt @db.Timestamptz
  deletedAt      DateTime?        @db.Timestamptz
  Question       Question[]
  QuizSubmission QuizSubmission[]
  User           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum question_type {
  MULTIPLE_CHOICE
  TRUE_FALSE
  SHORT_ANSWER
}

model Question {
  id              String        @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  quizId          String        @db.Uuid
  text            String
  type            question_type @default(MULTIPLE_CHOICE)
  trueFalseAnswer Boolean?      @default(false)
  points          Int           @default(1)
  shortAnswer     String?       @db.Text

  Quiz Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)

  createdAt        DateTime           @default(now()) @db.Timestamptz
  updatedAt        DateTime           @updatedAt @db.Timestamptz
  deletedAt        DateTime?          @db.Timestamptz
  answer           Answer[]
  AnswerSubmission AnswerSubmission[]
}

model Answer {
  id         String  @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  questionId String  @db.Uuid
  text       String?
  isCorrect  Boolean @default(false)

  Question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  createdAt        DateTime           @default(now()) @db.Timestamptz
  updatedAt        DateTime           @updatedAt @db.Timestamptz
  deletedAt        DateTime?          @db.Timestamptz
  AnswerSubmission AnswerSubmission[]

  @@unique([questionId, text])
}

model QuizSubmission {
  id          String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  quizId      String    @db.Uuid
  userId      String    @db.Uuid
  score       Float?
  timeTaken   Int? // seconds
  submittedAt DateTime? @db.Timestamptz

  Quiz Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)
  User User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt        DateTime           @default(now()) @db.Timestamptz
  updatedAt        DateTime           @updatedAt @db.Timestamptz
  deletedAt        DateTime?          @db.Timestamptz
  AnswerSubmission AnswerSubmission[]
}

model AnswerSubmission {
  id              String  @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  submittedQuizId String  @db.Uuid
  questionId      String  @db.Uuid
  answerId        String? @db.Uuid
  text            String?

  QuizSubmission QuizSubmission @relation(fields: [submittedQuizId], references: [id], onDelete: Cascade)
  Question       Question       @relation(fields: [questionId], references: [id], onDelete: Cascade)
  Answer         Answer?        @relation(fields: [answerId], references: [id], onDelete: SetNull)

  createdAt DateTime  @default(now()) @db.Timestamptz
  updatedAt DateTime  @updatedAt @db.Timestamptz
  deletedAt DateTime? @db.Timestamptz

  @@unique([submittedQuizId, questionId])
}
